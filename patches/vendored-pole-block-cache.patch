   fileCheck(file);
   if( !file.good() ) return 0;
 
+  // Serve a repeat read of the same block from memory. StreamIO::read() pulls
+  // a whole block per call while VPX consumes BIFF records two to four bytes
+  // at a time, so the same block is re-requested dozens of times in a row;
+  // without this each repeat is another seek+read syscall. That is invisible
+  // on internal storage and dominates table load time on high-latency media
+  // such as SD cards. One StorageIO now backs every stream of a table, so this
+  // also caches across streams; PoleStorage's mutex serializes all access.
+  // Only whole-block reads populate the cache, so a short read can never be
+  // used to satisfy a later, longer request for the same block.
+  if( cacheData && cacheLen > 0 && cacheBlock == block )
+  {
+    const uint64 n = ( maxlen < cacheLen ) ? maxlen : cacheLen;
+    memcpy( data, cacheData, (size_t) n );
+    return n;
+  }
+
   // wraps call for loadBigBlocks
   std::vector<uint64> blocks;
   blocks.resize( 1 );
   blocks[ 0 ] = block;
 
-  return loadBigBlocks( blocks, data, maxlen );
+  const uint64 bytes = loadBigBlocks( blocks, data, maxlen );
+
+  // A FAT chain that points past end of file (truncated download) makes
+  // loadBigBlocks() return a wrapped, huge count: never let that reach memcpy.
+  if( bytes > 0 && bytes <= bbat->blockSize && maxlen >= bbat->blockSize )
+  {
+    if( !cacheData ) cacheData = new unsigned char[ (size_t) bbat->blockSize ];
+    memcpy( cacheData, data, (size_t) bytes );
+    cacheBlock = block;
+    cacheLen = bytes;
+  }
+
+  return bytes;
