-      if (coreGlobals.nAlphaSegs) // Always return modulated value if available
+      // [seg-display fix] Mirror core.c's useDimmedSeg gate (core.c ~1426): only read the
+      // modulated PWM buffer when the table opts into physical alpha-segment outputs via
+      // options.usemodsol. Drivers set nAlphaSegs unconditionally (s11.c, gts80.c, gts3.c,
+      // by6803.c, wpc.c), but without the opt-in the PWM integrator is not a valid luminance
+      // source: System 80 BCD games leave it all-zero (blank displays) and strobed alpha
+      // displays alias against the poll interval (partially lit digits, e.g. S11 Taxi).
+      // Fall back to the binary segments[] state, exactly like core.c's video path.
+      if (coreGlobals.nAlphaSegs && (options.usemodsol & (CORE_MODOUT_FORCE_ON | CORE_MODOUT_ENABLE_PHYSOUT_ALPHASEGS)))
       {
          int pos = CORE_MODOUT_SEG0 + msgLocals.sortedSegLayout[i].statePos * 16;
