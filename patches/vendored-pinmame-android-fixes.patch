+// [diag] Read-only access to the raw PWM sub-frame ring for offline analysis tooling
+// (identify-stream research harness). Returns the ring base and its geometry.
+const UINT8* core_dmd_peek_raw_ring(const int displayIndex, unsigned int* nFrames, unsigned int* rawFrameSize, unsigned int* nextFrame, unsigned int* frameIndex)
+{
+  const core_tDMDPWMState* const dmd_state = (displayIndex >= 0 && displayIndex < 16) ? locals.dmdStates[displayIndex] : NULL;
+  if (dmd_state == NULL) return NULL;
+  *nFrames = dmd_state->nFrames;
+  *rawFrameSize = dmd_state->rawFrameSize;
+  *nextFrame = dmd_state->nextFrame;
+  *frameIndex = dmd_state->frame_index;
+  return dmd_state->rawFrames;
+}
